# Copy this file to ".env". The real .env is ignored by git.
# These values are for the local Docker database only. Never put a real password here.

POSTGRES_USER=safar724
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=safar724

# Port on your computer. Not 5432, so it cannot clash with a Postgres you already have installed.
DB_PORT=15432

# Used by the Go backend. Keep it in step with the four values above.
DATABASE_URL=postgres://safar724:local-dev-only@localhost:15432/safar724?sslmode=disable

# Optional. Where the API listens, and which website address may call it.
# Change these if a port is taken or blocked on your computer.
# API_ADDR=localhost:8080
# CORS_ORIGIN=http://localhost:5173
